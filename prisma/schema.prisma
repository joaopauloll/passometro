generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Paciente {
  id                 String    @id @default(cuid())
  nome               String
  leito              String
  registroHospitalar String
  dataInternacao     DateTime
  diagnostico        String
  cid                String?
  subespecialidade   String?
  cirurgioes         String    @default("[]") // JSON array de strings
  status             String    @default("INTERNADO") // INTERNADO | ALTA_ORTOPEDIA | ALTA_HOSPITALAR
  tipoStatus         String    @default("PRE_OPERATORIO") // PRE_OPERATORIO | POS_OPERATORIO
  comorbidades       String?
  medicacoes         String?
  alergias           String?
  dataNascimento     DateTime?
  temInfeccao        Boolean   @default(false)

  // Complicações
  compSolturaAssetica Boolean @default(false)
  compLuxacao         Boolean @default(false)
  compFalhaImplante   Boolean @default(false)
  compPseudoartrose   Boolean @default(false)
  compOutro           String?

  // História da doença atual
  historiaDoencaAtual String?
  houveTrauma         Boolean @default(false)

  // Campos legados de trauma, mantidos para histórico
  traumaMecanismo String?
  traumaData      DateTime?
  traumaTempo     String?

  // Novos campos estruturados
  cpf               String?
  comorbidadesJson  String? // JSON: {has,dm2,tabagismo,etilismo,avc,iam,drc,osteoporose,outros}
  funcaoRenal       String? // NORMAL | REDUZIDA
  prevCirurgiasOrto Boolean @default(false)
  prevCirurgiasJson String? // JSON array: [{nome,quando,cirurgiao}]
  temAlergia        Boolean @default(false)
  medicamentosJson  String? // JSON array: [{codigo,dataUltimoUso}]
  hemoglobinaAdm    Float?
  plaquetasAdm      Float?
  inrAdm            Float?
  infeccaoJson      String? // JSON: {febre,antibiotico,inicio,antibioticoPrevio,culturas,culturasResult,dreno}

  // Alta e follow-up
  altaOrtopediaData  DateTime?
  altaHospitalarData DateTime?
  previsaoAltaOrto   String? // ex: "2 dias após cirurgia"

  // Clínica médica
  clinicaMedico  String?
  aguardaClinica Boolean @default(false)

  // Risco cirúrgico
  riscoJson               String? // JSON: {concluido,data,cardiologista,nivel,indicaUTI,...}
  ecocardiogramaData      DateTime?
  ecocardiogramaResultado String?
  ecgData                 DateTime?
  ecgResultado            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cirurgias    Cirurgia[]
  evolucoes    Evolucao[]
  pendencias   Pendencia[]
  fotos        Foto[]
  pareceres    Parecer[]
  culturas     Cultura[]
  examesImagem ExameImagem[]
}

model Cirurgia {
  id                 String   @id @default(cuid())
  pacienteId         String
  nomeCirurgia       String
  cirurgiao          String
  dataCirurgia       DateTime
  hospitalExterno    String?
  diagnostico        String?
  cid                String?
  intercorrencia     Boolean  @default(false)
  intercorrenciaDesc String?
  createdAt          DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model Evolucao {
  id         String   @id @default(cuid())
  pacienteId String
  data       DateTime @default(now())

  // Estado geral
  estavel       Boolean?
  febre         Boolean?
  semDor        Boolean?
  dorControlada Boolean?

  // Eliminações
  diurese         String? // espontanea | svd | anurico
  ultimaEvacuacao String?

  // Exame físico
  perfusaoPreservada      Boolean?
  sensibilidadePreservada Boolean?
  movimentoPreservado     Boolean?

  // Imobilização
  usaGesso                 Boolean?
  qualGesso                String?
  imobilizacaoTipos        String? // JSON array: ['gesso','tala','tipoia',...]
  imobilizacaoLateralidade String? // direita | esquerda | bilateral

  // Curativo
  possuiCurativo        Boolean?
  curativoLimpo         Boolean?
  secrecaoInfecciosa    Boolean?
  secrecaoSanguinolenta Boolean?
  curativoLocal         String?
  curativoLateralidade  String? // direita | esquerda | bilateral

  // Pós-operatório
  rxPosOpRealizado   Boolean?
  rxSatisfatorio     Boolean?
  rxEnviadoCirurgiao Boolean?

  // Avaliação neurológica pós-op
  movPosOp      Boolean?
  sensPosOp     Boolean?
  deficitNeurol String? // melhorou | igual | piorou
  deficitPrevio Boolean? // tinha déficit neurológico pré-op?

  // Cardiovascular (≥55 anos)
  cardioPendente       Boolean?
  cardiologistaLiberou Boolean?
  solicitouEco         Boolean?
  ecoReady             Boolean?
  riscoConcluido       Boolean?
  necessitaUTI         Boolean?

  // Laboratórios básicos
  hemoglobina Float?
  plaquetas   Float?
  inr         Float?

  // Infecção ortopédica
  leucocitos            Float?
  pcr                   Float?
  vhs                   Float?
  creatinina            Float?
  ureia                 Float?
  culturasSolicitadas   Boolean?
  culturasResultado     Boolean?
  infectAvaliado        Boolean?
  nomeInfectologista    String?
  antibioticoAtual      String?
  diaTratamento         Int?
  antibioticosPrevios   String?
  lavCirurgicaRealizada Boolean?
  qtdLavagens           Int?
  retirouImplante       Boolean?

  // Avaliação de outras lesões (JSON array de {osso, lado, incidencias})
  outrasLesoes String?

  // Clínica médica
  acompClinico Boolean?
  nomeClinico  String?

  // Alta
  altaPrevista     Boolean?
  altaPrevistaData DateTime?
  altaHoje         Boolean?
  dataExame        DateTime?
  chkReceita     Boolean  @default(false)
  chkRelatorio   Boolean  @default(false)
  chkOrientacoes Boolean  @default(false)
  chkAtestado    Boolean  @default(false)
  chkRetorno     Boolean  @default(false)
  chkRX          Boolean  @default(false)

  // Reabilitação pós-op
  sentou              Boolean?
  iniciouFisioterapia Boolean?
  dreno               Boolean?
  drenoCm3            Float?
  drenoAspecto        String?

  // Texto e observações
  textoGerado String?
  observacoes String?

  createdAt DateTime @default(now())

  paciente   Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  pendencias Pendencia[]
}

model Pendencia {
  id         String   @id @default(cuid())
  pacienteId String
  evolucaoId String?
  descricao  String
  tipo       String // RX | RISCO_CIRURGICO | INFECTOLOGIA | ALTA | EXAME | CLINICA | OUTRO
  concluida  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paciente Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  evolucao Evolucao? @relation(fields: [evolucaoId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  acao      String
  detalhes  String?
  ip        String?
  createdAt DateTime @default(now())
}

model ExameImagem {
  id         String @id @default(cuid())
  pacienteId String

  data           DateTime
  tipoExame      String
  lateralidade   String   @default("nao_aplicavel")
  sitio          String
  laudo          String?
  hospitalOrigem String   @default("memorial")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model Configuracao {
  id                  String   @id @default("singleton")
  hospitalNome        String   @default("Hospital Memorial")
  hospitalLogotipoUrl String?
  hospitalEndereco    String?
  hospitalTelefone    String?
  ambulatorioEndereco String?
  ambulatorioTelefone String?
  updatedAt           DateTime @updatedAt
}

model Foto {
  id           String    @id @default(cuid())
  pacienteId   String
  tipo         String // RADIOGRAFIA | LESAO_PELE | CURATIVO
  lateralidade String?
  url          String
  dataFoto     DateTime?
  descricao    String?
  createdAt    DateTime  @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model Parecer {
  id            String   @id @default(cuid())
  pacienteId    String
  especialidade String
  data          DateTime
  descricao     String
  medico        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model Cultura {
  id         String    @id @default(cuid())
  pacienteId String
  dataColeta DateTime
  sitio      String
  resultado  String?
  dataResult DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model ModeloAlta {
  id            String @id @default(cuid())
  especialidade String
  cirurgiao     String
  nomeCirurgia  String

  // Recomendações (salvas como JSON string contendo os booleans e textos)
  // { podePisar, podeDobrarJoelho, podeSentar, podeTrocarCurativo, podeRetirarSuturas, podeDeitarLado, podeFazerFisioterapia, fisioterapiaRecomendacoes }
  recomendacoesJson String?

  // Textos de Orientações
  comoTrocarCurativo String?
  sinaisAlarme       String?

  // Retorno Ambulatorial
  retornoDias     Int?    @default(30)
  retornoTelefone String?
  retornoEndereco String? @default("Ambulatório do Hospital Memorial")
  retornoCep      String?

  // Prescrição
  // Array JSON de medicamentos selecionados: ["Dipirona 1g — 6/6h...", "Tramadol 50mg..."]
  prescricaoMedicamentos String?
  prescricaoTexto        String?

  // Órtese
  orteseTipo       String? @default("Nenhuma")
  orteseInstrucoes String?

  // Laudos e Atestados
  laudoTexto    String?
  atestadoTexto String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cirurgiao, nomeCirurgia])
}
